# Enforce LF line endings for all source files
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.gradle text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.jsonl text eol=lf
# The Gradle wrapper script has no extension and must keep LF to run under sh.
gradlew text eol=lf

# Keep CRLF for Windows-specific scripts
*.bat text eol=crlf
*.PS1 text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binary files - no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.keystore binary
*.jks binary
*.apk binary
*.aar binary
*.jar binary
*.zip binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary

# Ported test fixtures keep the bytes they had in FastMediaSorter, so a port ledger row's SHA-256 stays
# valid across line endings: the source is hashed as it is on disk there, and the ported copy here must
# not drift through a checkout that rewrites EOL. Applies to every file of the unit-test resource trees
# (conformance vectors, JSON fixtures, sample payloads).
phone/src/test/resources/** binary
wear/src/test/resources/** binary
*.html text eol=lf
*.css text eol=lf
# The family kit is served byte for byte as copied (site/assets/PROVENANCE.txt).
site/assets/sza-kit.css -text
