<?xml version="1.0" encoding="utf-8"?>
<!-- Watch Face Format metadata. Preview is the only required field. Category is deliberately absent: it
     is optional, and an invented value would pass the build in silence and surface as a store rejection.
     The preview is a placeholder of the skeleton face; the composition of the real face is owner
     decision 4.4 (before S0009) and re-captures the preview with it. -->
<WatchFaceInfo>
    <Preview value="@drawable/preview" />
    <Editable value="false" />
    <MultipleInstancesAllowed value="false" />
</WatchFaceInfo>
