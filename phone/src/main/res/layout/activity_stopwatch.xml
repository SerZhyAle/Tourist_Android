<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait host. Row 0 holds participants 0 and 2, row 1 holds 1 and 3, so one participant
     fills the screen, two split top and bottom, and four form a two-by-two grid without the binder
     moving a single view. The landscape file carries the SAME ids in a different placement. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/stopwatchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.sza.tourist.ui.common.widget.StandardToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Tourist.Toolbar.Flat"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/back"
        app:title="@string/stopwatch_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/stopwatchContentGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/stopwatchRow0"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/stopwatchRegion0"
                    layout="@layout/view_stopwatch_region"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/stopwatchRegion2"
                    layout="@layout/view_stopwatch_region"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stopwatchRow1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/stopwatchRegion1"
                    layout="@layout/view_stopwatch_region"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/stopwatchRegion3"
                    layout="@layout/view_stopwatch_region"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- The hardware volume keys drive the measurement on this screen, so the music level
                 gets an on-screen control. The row is hidden whole on a build with no audio - never shown
                 dead. -->
            <LinearLayout
                android:id="@+id/stopwatchVolumeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_small">

                <TextView
                    android:id="@+id/labelStopwatchVolume"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stopwatch_volume_label"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_size_small" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderStopwatchVolume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_weight="1"
                    android:contentDescription="@string/stopwatch_volume_label"
                    android:focusable="true"
                    android:stepSize="1"
                    android:valueFrom="0"
                    android:valueTo="15" />
            </LinearLayout>

            <com.sza.tourist.ui.common.widget.CommandFlowLayout
                android:id="@+id/stopwatchActionBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/margin_small">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStopwatchStartAll"
                    style="@style/Widget.Tourist.Button.Command"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_tiny"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/touch_target_min_height"
                    android:text="@string/stopwatch_action_start_all" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStopwatchResetAll"
                    style="@style/Widget.Tourist.Button.Command"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_tiny"
                    android:layout_marginStart="@dimen/margin_tiny"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/touch_target_min_height"
                    android:text="@string/stopwatch_action_reset_all" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStopwatchResult"
                    style="@style/Widget.Tourist.Button.Command"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_tiny"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/touch_target_min_height"
                    android:text="@string/stopwatch_action_result" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStopwatchSettings"
                    style="@style/Widget.Tourist.Button.Command"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:contentDescription="@string/stopwatch_action_settings"
                    android:focusable="true"
                    android:minHeight="@dimen/touch_target_min_height"
                    android:minWidth="@dimen/touch_target_min_height"
                    app:icon="@drawable/ic_settings"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />
            </com.sza.tourist.ui.common.widget.CommandFlowLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
