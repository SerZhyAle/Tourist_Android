<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/touristRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.sza.tourist.ui.common.widget.StandardToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Tourist.Toolbar.Flat"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/back"
        app:title="@string/tourist_info_title" />

    <!-- explains a missing grant and offers the request; gone while every needed grant is present. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_normal"
        android:layout_marginEnd="@dimen/margin_normal"
        android:layout_marginTop="@dimen/margin_small"
        android:visibility="gone"
        app:cardCornerRadius="@dimen/tourist_card_corner_radius"
        app:cardElevation="@dimen/tourist_card_elevation"
        app:strokeWidth="@dimen/tourist_card_stroke_width"
        app:strokeColor="?attr/colorError"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/padding_normal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tourist_status_permission_required"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorError" />

                <TextView
                    android:id="@+id/tvPermissionMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="@string/tourist_permission_location_message" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPermissionAction"
                style="@style/Widget.Tourist.Button.Tonal.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:focusable="true"
                tools:text="@string/tourist_permission_grant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- the card and the thirty-tile grid scroll as one page; the action bar stays pinned below. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollTouristPage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- Hero Focus Tile Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHeroTile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_normal"
        android:layout_marginEnd="@dimen/margin_normal"
        android:layout_marginTop="@dimen/margin_small"
        android:layout_marginBottom="@dimen/margin_medium"
        app:cardCornerRadius="@dimen/tourist_card_corner_radius"
        app:cardElevation="@dimen/tourist_card_elevation"
        app:strokeWidth="@dimen/tourist_card_stroke_width"
        app:strokeColor="?attr/colorPrimary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_normal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivHeroIcon"
                    android:layout_width="@dimen/tourist_hero_icon_size"
                    android:layout_height="@dimen/tourist_hero_icon_size"
                    android:contentDescription="@null"
                    app:tint="?attr/colorPrimary"
                    tools:src="@drawable/ic_speed" />

                <TextView
                    android:id="@+id/tvHeroTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold"
                    tools:text="Speed" />

                <ImageButton
                    android:id="@+id/btnHeroReset"
                    android:layout_width="@dimen/control_button_size_compact"
                    android:layout_height="@dimen/control_button_size_compact"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/tourist_action_reset_tile"
                    android:src="@drawable/ic_restore_defaults"
                    android:visibility="gone"
                    app:tint="?attr/colorPrimary"
                    tools:visibility="visible" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_normal"
                android:layout_marginBottom="@dimen/margin_medium">

                <LinearLayout
                    android:id="@+id/layoutHeroTextMetrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvHeroPrimaryValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/tourist_primary_text_size"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="0.0" />

                    <TextView
                        android:id="@+id/tvHeroPrimaryUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:layout_gravity="bottom"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="km/h" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutHeroCoords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <TextView
                        android:id="@+id/tvHeroLat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/tourist_coords_text_size"
                        android:textStyle="bold"
                        tools:text="Lat: 55.7558°" />

                    <TextView
                        android:id="@+id/tvHeroLon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/tourist_coords_text_size"
                        android:textStyle="bold"
                        tools:text="Lon: 37.6173°" />
                </LinearLayout>

                <!-- Equal columns keep heading changes from moving the compass rose. -->
                <LinearLayout
                    android:id="@+id/layoutHeroCompass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layoutDirection="ltr"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/ivHeroCompassRose"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/tourist_compass_rose_size"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_compass" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layoutDirection="locale">

                        <TextView
                            android:id="@+id/tvHeroCompassHeading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSurface"
                            android:textAppearance="@style/TextAppearance.Tourist.CompassHeading"
                            android:textStyle="bold"
                            tools:text="359°" />

                        <TextView
                            android:id="@+id/tvHeroCompassCardinal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="NW" />
                    </LinearLayout>
                </LinearLayout>

            </FrameLayout>

            <!-- the wind / course / trend arrow and the level gauge; at most one is visible. -->
            <FrameLayout
                android:id="@+id/layoutHeroVisual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivHeroDirectionArrow"
                    android:layout_width="@dimen/tourist_compass_rose_size"
                    android:layout_height="@dimen/tourist_compass_rose_size"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_upward"
                    android:visibility="gone"
                    app:tint="?attr/colorOnSurface" />

                <!-- The GYROSCOPE tile's phone-shaped box, turned by the device attitude. -->
                <com.sza.tourist.ui.tourist.view.AttitudeBoxView
                    android:id="@+id/viewHeroAttitude"
                    android:layout_width="@dimen/tourist_compass_rose_size"
                    android:layout_height="@dimen/tourist_compass_rose_size"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/layoutHeroLevel"
                    android:layout_width="@dimen/tourist_level_ring_size"
                    android:layout_height="@dimen/tourist_level_ring_size"
                    android:layout_gravity="center"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivHeroLevelRing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:src="@drawable/bg_tourist_level_ring" />

                    <ImageView
                        android:id="@+id/ivHeroLevelBubble"
                        android:layout_width="@dimen/tourist_level_bubble_size"
                        android:layout_height="@dimen/tourist_level_bubble_size"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/bg_tourist_level_bubble" />
                </FrameLayout>
            </FrameLayout>


            <!-- the STOPWATCH tile is itself a primitive stopwatch; the row is hidden for every other tile. -->
            <com.sza.tourist.ui.common.widget.CommandFlowLayout
                android:id="@+id/layoutHeroStopwatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:visibility="gone"
                tools:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStopwatchToggle"
                    style="@style/Widget.Tourist.Button.Tonal.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_small"
                    app:icon="@drawable/ic_play"
                    android:text="@string/tourist_stopwatch_action_start"
                    tools:text="Start" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStopwatchReset"
                    style="@style/Widget.Tourist.Button.Outlined.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_small"
                    app:icon="@drawable/ic_restore_defaults"
                    android:text="@string/tourist_stopwatch_action_reset"
                    tools:text="Reset" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStopwatchOpen"
                    style="@style/Widget.Tourist.Button.Tonal.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_stopwatch"
                    android:text="@string/tourist_stopwatch_action_open_full"
                    tools:text="Open stopwatch" />
            </com.sza.tourist.ui.common.widget.CommandFlowLayout>
            <TextView
                android:id="@+id/tvHeroSecondaryDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Max: 0.0 km/h • Trip: 0.00 km" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Secondary Tiles Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSecondaryTiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingStart="@dimen/margin_normal"
        android:paddingEnd="@dimen/margin_normal"
        android:paddingBottom="@dimen/margin_normal" />
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Action Bar -->
    <com.sza.tourist.ui.common.widget.CommandFlowLayout
        android:id="@+id/layoutActionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/margin_normal"
        android:paddingEnd="@dimen/margin_normal"
        android:paddingTop="@dimen/padding_small"
        android:paddingBottom="@dimen/padding_small">

        

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenMap"
            style="@style/Widget.Tourist.Button.Tonal.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_map"
            android:text="@string/tourist_action_open_map" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareLocation"
            style="@style/Widget.Tourist.Button.Tonal.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_share"
            android:text="@string/tourist_action_share_location" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetTrip"
            style="@style/Widget.Tourist.Button.Outlined.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_restore_defaults"
            android:text="@string/tourist_action_reset_trip" />

        <!-- The distress signal, last in the row and the only filled button among the four -
             the other three act on a location and this one calls for help, so it must not read as one
             more of them. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSos"
            style="@style/Widget.Tourist.Button.Filled.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/color_program_accent_red"
            android:textColor="@color/white"
            app:iconTint="@color/white"
            android:text="@string/tourist_action_sos"
            app:icon="@drawable/ic_sos" />
    </com.sza.tourist.ui.common.widget.CommandFlowLayout>
</LinearLayout>
