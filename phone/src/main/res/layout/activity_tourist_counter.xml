<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/counterRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.sza.tourist.ui.common.widget.StandardToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Tourist.Toolbar.Flat"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/back"
        app:title="@string/tourist_tile_counter" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollCounter"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_normal">

            <TextView
                android:id="@+id/tvCounterValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textAppearance="?attr/textAppearanceDisplayLarge"
                android:textStyle="bold"
                tools:text="128" />

            <TextView
                android:id="@+id/tvCounterStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="@string/tourist_counter_start_label" />

            <com.sza.tourist.ui.common.widget.CommandFlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMinusOne"
                    style="@style/Widget.Tourist.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/tourist_counter_minus_one_description"
                    android:focusable="true"
                    android:nextFocusRight="@id/btnPlusOne"
                    tools:text="-1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlusOne"
                    style="@style/Widget.Tourist.Button.Filled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_normal"
                    android:contentDescription="@string/tourist_counter_plus_one_description"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btnMinusOne"
                    tools:text="+1"
                    android:textAppearance="?attr/textAppearanceHeadlineLarge">

                    <requestFocus />
                </com.google.android.material.button.MaterialButton>
            </com.sza.tourist.ui.common.widget.CommandFlowLayout>

            <com.sza.tourist.ui.common.widget.SettingsCheckboxRow
                android:id="@+id/switchExtraSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_normal"
                android:focusable="true"
                app:scr_icon="@drawable/ic_add"
                app:scr_title="@string/tourist_counter_extra_steps" />

            <include
                android:id="@+id/extraSteps"
                layout="@layout/include_tourist_counter_extra_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.sza.tourist.ui.common.widget.CommandFlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_normal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartValue"
                    style="@style/Widget.Tourist.Button.Command"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:text="@string/tourist_counter_set_start" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReset"
                    style="@style/Widget.Tourist.Button.Command"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_normal"
                    android:focusable="true"
                    android:text="@string/tourist_counter_reset" />
            </com.sza.tourist.ui.common.widget.CommandFlowLayout>

            <include
                android:id="@+id/history"
                layout="@layout/include_tourist_counter_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
