<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout for SettingsDropdownRow compound view.
  Title, then a Material outlined field (TextInputLayout + read-only TextInputEditText)
  that opens the row's own modal option list.
  The help icon of the source stays behind with the in-app help (S0014).
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/sdr_textGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/sdr_titleLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/sdr_titleCluster"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sdr_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/toggler_title_text_size" />

            </LinearLayout>

            <TextView
                android:id="@+id/sdr_valueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/settings_help_icon_margin"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/settings_row_value_text_size"
                android:textStyle="bold"
                android:visibility="gone" />

            <View
                android:id="@+id/sdr_titleLineSpacer"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

        </LinearLayout>

        <TextView
            android:id="@+id/sdr_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_color_secondary"
            android:textSize="@dimen/toggler_desc_text_size"
            android:visibility="gone" />

    </LinearLayout>

    <!--
      A custom end icon instead of the ExposedDropdownMenu style, because that style hands the
      click to AutoCompleteTextView.showDropDown() and its non-modal popup is unreachable by D-pad and
      invisible to accessibility. The row opens a modal ListPopupWindow itself.
    -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/sdr_inputLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:endIconContentDescription="@string/cd_choose_from_list"
        app:endIconDrawable="@drawable/ic_arrow_drop_down"
        app:endIconMode="custom">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/sdr_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:cursorVisible="false"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:inputType="none"
            android:longClickable="false"
            android:textSize="@dimen/toggler_title_text_size" />

    </com.google.android.material.textfield.TextInputLayout>

    <ImageView
        android:id="@+id/sdr_valueTextIcon"
        android:layout_width="@dimen/settings_help_icon_size"
        android:layout_height="@dimen/settings_help_icon_size"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/settings_help_icon_margin"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right"
        app:tint="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

</merge>
