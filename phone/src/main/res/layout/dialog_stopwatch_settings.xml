<?xml version="1.0" encoding="utf-8"?>
<!-- Built on the custom settings rows rather than bare Material widgets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/margin_medium">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.sza.tourist.ui.common.widget.SettingsDropdownRow
                android:id="@+id/rowStopwatchParticipants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                app:sdr_inline="true"
                app:sdr_title="@string/stopwatch_settings_participants" />

            <com.sza.tourist.ui.common.widget.SettingsCheckboxRow
                android:id="@+id/rowStopwatchMusic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                app:scr_subtitle="@string/stopwatch_settings_music_summary"
                app:scr_title="@string/stopwatch_settings_music" />

            <com.sza.tourist.ui.common.widget.SettingsSelectionRow
                android:id="@+id/rowStopwatchTrack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                app:ssr_showChevron="true"
                app:ssr_title="@string/stopwatch_settings_track"
                app:ssr_value="@string/stopwatch_settings_track_none" />

            <com.sza.tourist.ui.common.widget.SettingsCheckboxRow
                android:id="@+id/rowStopwatchVolumeKeys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:scr_subtitle="@string/stopwatch_settings_volume_keys_summary"
                app:scr_title="@string/stopwatch_settings_volume_keys" />
        </LinearLayout>
    </ScrollView>

    <com.sza.tourist.ui.common.widget.CommandFlowLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStopwatchSettingsCancel"
            style="@style/Widget.Tourist.Button.DialogCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStopwatchSettingsApply"
            style="@style/Widget.Tourist.Button.DialogConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialog_action_button_gap"
            android:text="@string/apply" />
    </com.sza.tourist.ui.common.widget.CommandFlowLayout>
</LinearLayout>
