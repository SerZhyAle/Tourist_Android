<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tourist" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/tourist_green</item>
        <item name="android:statusBarColor">@color/tourist_night</item>
    </style>

    <!-- The ported dashboard's controls, renamed from FastMediaSorter's namespace (S0004). -->
    <style name="Widget.Tourist.Button.Filled" parent="Widget.Material3.Button">
        <item name="android:letterSpacing">0</item>
        <item name="textAllCaps">false</item>
        <item name="cornerRadius">@dimen/token_radius_12</item>
        <item name="android:minHeight">@dimen/token_touch_target_min</item>
    </style>

    <style name="Widget.Tourist.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:letterSpacing">0</item>
        <item name="textAllCaps">false</item>
        <item name="cornerRadius">@dimen/token_radius_12</item>
        <item name="android:minHeight">@dimen/token_touch_target_min</item>
    </style>

    <style name="Widget.Tourist.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:letterSpacing">0</item>
        <item name="textAllCaps">false</item>
        <item name="cornerRadius">@dimen/token_radius_12</item>
        <item name="android:minHeight">@dimen/token_touch_target_min</item>
    </style>

    <style name="Widget.Tourist.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:letterSpacing">0</item>
        <item name="textAllCaps">false</item>
        <item name="cornerRadius">@dimen/token_radius_12</item>
        <item name="android:minHeight">@dimen/token_touch_target_min</item>
    </style>

    <!-- Content-sized ordinary commands: the geometry of the base style at 12sp. -->
    <style name="Widget.Tourist.Button.Filled.Compact">
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/padding_normal</item>
        <item name="android:paddingEnd">@dimen/padding_normal</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="iconPadding">@dimen/margin_small</item>
    </style>

    <style name="Widget.Tourist.Button.Tonal.Compact">
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/padding_normal</item>
        <item name="android:paddingEnd">@dimen/padding_normal</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="iconPadding">@dimen/margin_small</item>
    </style>

    <style name="Widget.Tourist.Button.Outlined.Compact">
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/padding_normal</item>
        <item name="android:paddingEnd">@dimen/padding_normal</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="iconPadding">@dimen/margin_small</item>
    </style>

    <style name="Widget.Tourist.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:elevation">0dp</item>
        <item name="titleTextAppearance">@style/TextAppearance.Tourist.Bar.Title</item>
    </style>

    <!-- Flat leaves the host surface showing through instead of tinting the bar with the brand colour. -->
    <style name="Widget.Tourist.Toolbar.Flat">
        <item name="android:background">@android:color/transparent</item>
        <item name="navigationIconTint">?attr/colorControlNormal</item>
    </style>

    <style name="TextAppearance.Tourist.Bar.Title" parent="TextAppearance.Material3.TitleLarge" />

    <style name="TextAppearance.Tourist.CompassHeading" parent="TextAppearance.Material3.DisplaySmall" />
</resources>
