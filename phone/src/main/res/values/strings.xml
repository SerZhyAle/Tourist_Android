    <string name="settings_description">Tourist is a hiking kit for your phone and watch: readings, a trip counter, lights, SOS and a stopwatch.</string>
    <string name="settings_version">Version %1$s (%2$d)</string>
    <string name="settings_resources">Resources</string>
    <string name="settings_license_text">License: MIT. Permission is granted to use, copy, modify and distribute this software with its copyright and license notice. The software is provided without warranty.</string>
    <string name="settings_privacy_text">Privacy: location is read only while a location screen is open. A weather request sends coordinates to Open-Meteo. Paired devices exchange toolkit settings, readings and signal commands. The camera permission drives the torch. Activity and health grants supply their named readings. Music access reads the track you choose. Notifications show the shortcuts you enable. Diagnostics contain build and platform values only; you choose where to save the ZIP. SOS makes no call and sends no SMS.</string>
    <string name="settings_help">Help</string>
    <string name="settings_export">Export diagnostics</string>
    <string name="settings_diagnostics_description">Saves a ZIP with the app version, Android API and memory limit. No coordinates, history, music path or user text is included. Nothing is uploaded.</string>
    <string name="settings_export_saved">Diagnostic bundle saved</string>
    <string name="settings_export_failed">Could not save diagnostics. Choose another destination and retry.</string>
    <string name="settings_resource_index">Resources: offline help and the MIT license. The companion watch face includes its fonts and third-party notices.</string>
