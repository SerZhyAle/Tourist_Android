<?xml version="1.0" encoding="utf-8"?>
<!--
    The one status-bar icon every notification this product posts uses.

    A fork of ic_compass.xml rather than a reference to it: the original carries three concrete
    colours, while a status-bar icon must be a plain alpha silhouette - the system tints it itself.
    Do not add a theme tint here; a theme attribute cannot resolve outside the app theme, and posting
    then throws. The white fill is the shape, not the colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Outer compass ring -->
    <path
        android:fillColor="@color/white"
        android:pathData="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM12,20c-4.42,0 -8,-3.58 -8,-8s3.58,-8 8,-8 8,3.58 8,8 -3.58,8 -8,8z"/>
    <!-- North pointer -->
    <path
        android:fillColor="@color/white"
        android:pathData="M12,4.5L15,12L12,10.2L9,12Z"/>
    <!-- South pointer -->
    <path
        android:fillColor="@color/white"
        android:pathData="M12,19.5L9,12L12,13.8L15,12Z"/>
</vector>
